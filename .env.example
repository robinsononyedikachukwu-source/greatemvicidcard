# Copy these into your host's environment settings (never commit real values to a public repo).
PORT=3000
# Required: your MongoDB Atlas connection string. The server will refuse to start without this.
MONGODB_URI=mongodb+srv://someuser:somepassword@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Optional: database name inside your Atlas cluster (default: great_emvic)
MONGODB_DB=great_emvic
# Optional: create the super account from these instead of the EMBEDDED_SUPER constant in server.js.
# SUPER_NAME=Your Name
# SUPER_USERNAME=owner
# SUPER_PASSWORD=change-this-long-password
# Set to 1 when the app sits behind a proxy/host that terminates HTTPS (Render, Railway, Caddy, nginx):
TRUST_PROXY=1
SESSION_HOURS=12
